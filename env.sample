# Strado environment flags — reference for dev runs and packaged builds.
# Nothing here is required for `npm run desktop`; every flag has a default.

## ---- local server (packages/server) ----

# HTTP port for the local server + dashboard.
PORT=7777

# Config dir (workspaces.json, per-workspace stores).
# Default: <cwd>/config in dev; packaged builds force ~/.strado/config.
#STRADO_CONFIG_DIR=

# Home state dir (activity.json, jira.json, license.json). Default ~/.strado.
#STRADO_HOME=

# Static web bundle to serve. Default: packages/web/dist (dev layout);
# packaged builds point it at Resources/web.
#STRADO_WEB_DIST=

# Claude/Codex status-hook scripts dir. Default: packages/server/hooks.
#STRADO_HOOKS_DIR=

# Port for VS Code web (`code serve-web`) embedded in the hub.
VSCODE_WEB_PORT=7788

## ---- invite gate + telemetry (shipped builds) ----

# '1' shows the invite-code lock screen before the app. Packaged builds set
# this themselves; leave unset in dev.
#STRADO_LICENSE_REQUIRED=1

# Base URL of strado-api (the hosted Strado Cloud service). Default https://api.strado.io —
# override for local testing: http://127.0.0.1:8790
#STRADO_LICENSE_API=

# '0' disables usage telemetry (only active in gated builds anyway).
#STRADO_TELEMETRY=0

## ---- desktop shell (packages/desktop) ----

# CDP endpoint for agent browser access (strado-preview MCP). The `desktop`
# npm script sets 9222; packaged builds default to 9222; '0' disables.
#STRADO_CDP_PORT=9222
